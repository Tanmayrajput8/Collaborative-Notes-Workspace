# ============================================================
# Environment Variables for Distributed Collaborative Notes
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# MongoDB Connection String
# If using local MongoDB:
MONGODB_URI=mongodb://localhost:27017/collaborative-notes

# If using MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/collaborative-notes

# Service Ports
API_GATEWAY_PORT=3000
DOCUMENT_SERVICE_PORT=5001
COLLABORATION_SERVICE_PORT=5002

# Service URLs (used by API Gateway to forward requests)
DOCUMENT_SERVICE_URL=http://localhost:5001
COLLABORATION_SERVICE_URL=http://localhost:5002
